PORT=3000
DATABASE_URL=postgres://tracker:tracker@localhost:15432/tracker
JWT_SECRET=change-me-to-a-long-random-string
# Sent by the mobile app in the X-App-Key header (must match --dart-define=APP_KEY=... in the app)
APP_KEY=change-me-app-key
# The system admin: created automatically on first start if no admin exists (only used once).
# Afterwards change it with `npm run system-admin -- <email> <password>`
ADMIN_EMAIL=admin@demokrito.com
ADMIN_PASSWORD=ChangeMe123!
# Comma separated list of allowed web origins ("*" for any)
CORS_ORIGIN=http://localhost:5173
# New devices must be approved by an admin before their data is stored
REQUIRE_DEVICE_APPROVAL=true
# Stay detection
STAY_RADIUS_M=50
STAY_MIN_SECONDS=300
MAX_ACCURACY_M=50
# Worker is "offline" after this many seconds without a location
ONLINE_WINDOW_SECONDS=300
# Raw points older than this are deleted (0 = keep forever)
RETENTION_DAYS=90
# A silence longer than this (seconds) ends a stop instead of counting as standing time
STAY_MAX_GAP_SECONDS=900
# Alerts
OFFLINE_ALERT_MINUTES=15
LOW_BATTERY_PERCENT=15
# Street addresses for stops via OpenStreetMap Nominatim (sends stop coordinates to that public service)
REVERSE_GEOCODE=false
# Uploaded app (APK) files
UPLOADS_DIR=./uploads
MAX_APK_MB=300
# Time zone of times written in CSV exports (the database itself stays in UTC)
REPORT_TIMEZONE=Asia/Kolkata
